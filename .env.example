# Copy to .env.local for local development. Never commit real values.

# --- Required ---------------------------------------------------------------
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_ORG=

# --- Org management (set one option) ---------------------------------------
# Option A: a personal access token with org/admin rights.
GITHUB_ORG_TOKEN=

# Option B: a GitHub App. In containers use the inline PEM; the _PATH form is
# for local files only.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=./private-key.pem

# --- Optional ---------------------------------------------------------------
# Behind a proxy or in a container the public origin must be explicit.
# AUTH_URL must be the exact origin, with no trailing slash.
# AUTH_URL=https://3-109-190-247.sslip.io
# AUTH_TRUST_HOST=true

# --- Session timeout --------------------------------------------------------
# Absolute session lifetime in seconds (default: 8 hours = 28800).
# AUTH_SESSION_MAX_AGE=28800
# How often to refresh the session in the background (default: 1 hour = 3600).
# AUTH_SESSION_UPDATE_AGE=3600
# Client-side inactivity timeout in minutes before warning (default: 30).
# AUTH_INACTIVITY_WARN_MINUTES=30
# How long after the warning before auto sign-out (default: 2 minutes).
# AUTH_INACTIVITY_SIGN_OUT_MINUTES=2

# Slug of the org team that grants faculty access (defaults to probing
# faculty / teachers / staff).
GITHUB_FACULTY_TEAM=

# Set to false in production to start with an empty assignments/announcements
# store instead of the demo rows.
SEED_DUMMY_DATA=false

# Optional DynamoDB mirror. Without these the stores are per-instance memory.
# On EC2, prefer AWS_INSTANCE_ROLE=true over static keys.
DYNAMODB_TABLE=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_INSTANCE_ROLE=true
# DYNAMODB_ENDPOINT=

# --- Dev-only test login (never enable in production) ----------------------
# DEV_TEST_AUTH=true
# NEXT_PUBLIC_DEV_TEST_AUTH=true
