# Copy to .env.local for local development. Never commit real values.

# --- Required ---------------------------------------------------------------
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_ORG=

# --- Org management (set one option) ---------------------------------------
# Option A: a personal access token with org/admin rights.
GITHUB_ORG_TOKEN=

# Option B: a GitHub App. On Vercel use the inline PEM; the _PATH form is for
# local files only.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=./private-key.pem

# --- Optional ---------------------------------------------------------------
# Slug of the org team that grants faculty access (defaults to probing
# faculty / teachers / staff).
GITHUB_FACULTY_TEAM=

# Set to false in production to start with an empty assignments/announcements
# store instead of the demo rows.
SEED_DUMMY_DATA=false

# Optional DynamoDB mirror. Without these the stores are per-instance memory.
DYNAMODB_TABLE=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# DYNAMODB_ENDPOINT=

# --- Dev-only test login (never enable in production) ----------------------
# DEV_TEST_AUTH=true
# NEXT_PUBLIC_DEV_TEST_AUTH=true
