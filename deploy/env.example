# Public, non-secret deployment config. Copy to .env on the host.
# (Secrets live in secrets.env, generated from SSM by render-secrets.sh.)

# Hostname WITHOUT a domain: the Elastic IP with dots replaced by dashes,
# plus .sslip.io. Example: 13.234.56.78 -> 13-234-56-78.sslip.io
APP_HOST=13-234-56-78.sslip.io

# Let's Encrypt account contact (used for expiry notices).
ACME_EMAIL=you@example.com

# Container image. Pull from ECR on the host, or leave blank to build locally.
APP_IMAGE=<ACCOUNT_ID>.dkr.ecr.ap-south-1.amazonaws.com/kjit-classroom:latest
